---
import ThemeShell from "@emdash-cms/astro-themes/ThemeShell.astro";
import { getEntry, getNavigation, getSite } from "../../lib/cms";

const slug = Astro.params.slug ?? "";
const [site, page, navigation] = await Promise.all([getSite(), getEntry("pages", slug), getNavigation()]);
if (!page) return Astro.redirect("/");
const title = typeof page.data.title === "string" ? page.data.title : "Untitled";
const excerpt = typeof page.data.excerpt === "string" ? page.data.excerpt : "";
const blocks = Array.isArray(page.data.content) ? page.data.content : [];

function blockText(block: unknown): string {
	if (typeof block !== "object" || block === null || !("children" in block) || !Array.isArray(block.children)) return "";
	return block.children
		.map((child: unknown) =>
			typeof child === "object" && child !== null && "text" in child ? String(child.text) : "",
		)
		.join("");
}
---

<ThemeShell site={site} navigationItems={navigation.length ? navigation : undefined} title={`${title} — ${site.name}`} description={excerpt}>
	<article class:list={["page", site.theme.id]}>
		<h1>{title}</h1>
		{excerpt && <p class="lede">{excerpt}</p>}
		<div class="body">{blocks.map((block) => blockText(block) && <p>{blockText(block)}</p>)}</div>
	</article>
</ThemeShell>

<style>
	.page { max-width: 48rem; margin: auto; padding: 4rem 1.5rem 0; }
	.page.catalog { max-width: 64rem; }
	h1 { margin: .7rem 0 1rem; font-size: clamp(2.5rem, 7vw, 4.8rem); letter-spacing: -.06em; line-height: .95; }
	.lede { color: var(--muted); font-size: 1.3rem; line-height: 1.6; }
	.body { margin-top: 2rem; font-size: 1.13rem; line-height: 1.8; }
</style>
