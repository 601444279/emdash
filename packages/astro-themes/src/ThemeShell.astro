---
import type { ThemeSite } from "./types";

interface Props {
	site: ThemeSite;
	title: string;
	description?: string;
	navigationItems?: Array<{ label: string; href: string }>;
}

const { site, title, description, navigationItems = [{ label: "Articles", href: "/posts" }, { label: "Search", href: "/search" }] } = Astro.props;
const palette = site.theme.settings.palette ?? "ocean";
const font = site.theme.settings.font === "serif" ? "serif" : "sans";
const navigation = ["centered", "stacked"].includes(site.theme.settings.navigation)
	? site.theme.settings.navigation
	: "inline";
const footer = site.theme.settings.footer === "compact" ? "compact" : "columns";
const canonicalUrl = new URL(Astro.url.pathname, Astro.url).toString();
---

<!doctype html>
<html lang="en" data-theme={site.theme.id} data-palette={palette} data-font={font}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		{description && <meta property="og:description" content={description} />}
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
	</head>
	<body>
		{site.theme.id === "ranked" && (
			<div class="research-bar">
				<span>Independent hosting research</span>
				<span>Reviews · comparisons · practical guides</span>
			</div>
		)}
		<header class:list={["site-header", navigation === "centered" && "centered", navigation === "stacked" && "stacked"]}>
			<a class="brand" href="/">{site.name}</a>
			<nav aria-label="Primary navigation">
				{navigationItems.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
		</header>
		<main><slot /></main>
		<footer class:list={["site-footer", footer]}>
			<span>© {new Date().getFullYear()} {site.name}</span>
			{site.theme.id === "ranked" && <span>Editorial research for informed infrastructure decisions.</span>}
		</footer>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; background: var(--canvas); color: var(--ink); font-family: "Avenir Next", Avenir, "Trebuchet MS", sans-serif; }
	:global(html[data-font="serif"] body) { font-family: Charter, "Iowan Old Style", Georgia, serif; }
	:global(html[data-font="serif"] .brand), :global(html[data-font="serif"] h1), :global(html[data-font="serif"] h2) { letter-spacing: -.025em; }
	:global(a) { color: inherit; text-decoration: none; }
	:global(.site-header), :global(main), :global(.site-footer) { max-width: 72rem; margin: auto; padding-inline: 1.5rem; }
	:global(.site-header) { min-height: 5rem; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
	:global(.site-header.centered) { justify-content: center; gap: 3rem; }
	:global(.site-header.stacked) { min-height: 7rem; flex-direction: column; justify-content: center; gap: .75rem; }
	:global(.brand) { font-weight: 800; letter-spacing: -.04em; font-size: 1.35rem; }
	:global(nav) { display: flex; gap: 1.25rem; color: var(--muted); font-size: .95rem; }
	:global(.site-footer) { border-top: 1px solid var(--line); margin-top: 5rem; padding-block: 2rem; color: var(--muted); font-size: .9rem; }
	:global(.site-footer.columns) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
	:global(.site-footer.compact) { text-align: center; }
	:global(html) { --canvas: #f7fafc; --paper: #fff; --ink: #182536; --muted: #617086; --line: #dce4ed; --accent: #1769e0; }
	:global(html[data-palette="forest"]) { --accent: #147a4f; }
	:global(html[data-palette="slate"]) { --accent: #334155; --canvas: #f8fafc; }
	:global(html[data-palette="amber"]) { --accent: #b95700; --canvas: #fffaf3; }
	:global(html[data-palette="indigo"]) { --accent: #4c46cb; }
	:global(html[data-palette="graphite"]) { --accent: #303744; --canvas: #f7f7f8; }
	:global(html[data-theme="ranked"]) { --canvas: #f2f0e9; --paper: #fffdfa; --ink: #153a34; --muted: #5d6b64; --line: #d3d7ca; --accent: #b56b31; }
	:global(html[data-theme="ranked"][data-palette="slate"]) { --canvas: #f1f3f1; --ink: #26363b; --accent: #336e76; }
	:global(html[data-theme="ranked"][data-palette="amber"]) { --canvas: #fbf4e8; --ink: #382e25; --accent: #ae5c1d; }
	:global(html[data-theme="ranked"] body) { background-image: linear-gradient(90deg, rgb(21 58 52 / 3%) 1px, transparent 1px), linear-gradient(rgb(21 58 52 / 3%) 1px, transparent 1px); background-size: 32px 32px; }
	:global(html[data-theme="ranked"] .research-bar) { display: flex; justify-content: space-between; gap: 1rem; padding: .55rem max(1.5rem, calc((100vw - 78rem) / 2)); background: var(--ink); color: #f7eddd; font-family: "Avenir Next", Avenir, sans-serif; font-size: .68rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
	:global(html[data-theme="ranked"] .site-header), :global(html[data-theme="ranked"] main), :global(html[data-theme="ranked"] .site-footer) { max-width: 78rem; }
	:global(html[data-theme="ranked"] .site-header) { min-height: 5.8rem; border-bottom: 2px solid var(--ink); }
	:global(html[data-theme="ranked"] .brand) { font-family: Charter, "Iowan Old Style", Georgia, serif; font-size: 1.7rem; font-weight: 700; letter-spacing: -.05em; }
	:global(html[data-theme="ranked"] nav) { color: var(--ink); font-family: "Avenir Next", Avenir, sans-serif; font-size: .76rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	:global(html[data-theme="ranked"] nav a:hover) { color: var(--accent); }
	:global(html[data-theme="ranked"] .site-footer) { display: flex; justify-content: space-between; gap: 1rem; border-top: 2px solid var(--ink); color: var(--muted); font-family: "Avenir Next", Avenir, sans-serif; font-size: .75rem; letter-spacing: .04em; }
	@media (max-width: 42rem) { :global(html[data-theme="ranked"] .research-bar), :global(html[data-theme="ranked"] .site-header), :global(html[data-theme="ranked"] .site-footer) { align-items: flex-start; flex-direction: column; } :global(html[data-theme="ranked"] .site-header) { min-height: auto; padding-block: 1.25rem; gap: 1rem; } :global(html[data-theme="ranked"] nav) { flex-wrap: wrap; gap: .8rem 1rem; } }
</style>
